# ---------------------------------------------------------------------------
# BaseDex environment — copy to .env and fill in. NEVER commit your real .env.
# ---------------------------------------------------------------------------

# Deployer wallet for `forge script script/Deploy.s.sol --broadcast`.
# MUST be a throwaway testnet key funded with Base Sepolia ETH only.
PRIVATE_KEY=

# Optional: verify contracts on Basescan during deployment (--verify flag).
# Get a free key at https://basescan.org/myapikey
BASESCAN_API_KEY=

# Optional: custom Base Sepolia RPC for the frontend (default: https://sepolia.base.org)
# e.g. https://base-sepolia.g.alchemy.com/v2/<key>
VITE_RPC_URL=
